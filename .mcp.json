{
  "mcpServers": {
    "atlassian": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "https://jira.TODO",
        "JIRA_PERSONAL_TOKEN": "${JIRA_PAT}",
        "CONFLUENCE_URL": "https://confluence.TODO",
        "CONFLUENCE_PERSONAL_TOKEN": "${CONFLUENCE_PAT}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser", "msedge",
        "--isolated",
        "--allowed-origins", "https://TODO-test-env-1;https://TODO-test-env-2"
      ]
    },
    "windows-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.13", "windows-mcp", "serve"],
      "env": {
        "ANONYMIZED_TELEMETRY": "false"
      }
    }
  }
}
